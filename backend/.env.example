# Скопируйте в .env. Реальных секретов здесь нет: всё локальное и вымышленное.
DATABASE_URL="postgresql://renewals:renewals@127.0.0.1:5433/renewals?schema=public"
PORT=4000

# Имитатор провайдера
PROVIDER_URL="http://127.0.0.1:8091"
PROVIDER_TIMEOUT_MS=5000

# Пауза после неопределённого ответа (503/таймаут) перед проверкой GET или повторным POST.
# Увеличьте, чтобы успеть остановить приложение в сценарии с перезапуском.
PROVIDER_RETRY_DELAY_MS=15000

# Как часто фоновый обработчик ищет задачи
WORKER_POLL_MS=1000
WORKER_ENABLED=true
